# Store as /opt/crypto-platform/.env.production with mode 600. Never commit live values.
APP_DOMAIN=example.com
POSTGRES_DB=crypto_trading
POSTGRES_USER=crypto_user
POSTGRES_PASSWORD=replace-with-random-value
MONGO_DB=crypto_market
MONGO_USER=crypto_user
MONGO_PASSWORD=replace-with-random-value
REDIS_PASSWORD=replace-with-random-value
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
AUTH_DATA_ENCRYPTION_KEY=replace-with-a-Fernet-key
EXCHANGE_ENCRYPTION_KEY=replace-with-a-32-byte-base64-key
# Optional: SENTRY_DSN=https://project-key@your-sentry-host/1
# Optional: NOTIFICATION_EMAIL_PROVIDER=smtp (set corresponding email settings)
